# 项目自带的 Python（打包用，约 1 GB，不进版本库）
python/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 前端依赖（electron 装出来约 369 MB，不进版本库；换机 pnpm/npm install 即可）
ui/desktop/node_modules/

# 运行产物（切片、抽帧、界面设置、监视器状态都在这里）
output/

# 临时/调试（scratch 下都是随手产物，随时可删）
scratch/
_*.png
_download/

# 沙箱 ACL 修复留档（备份 + 还原脚本）
.acl-recovery/

# 系统
Thumbs.db
desktop.ini
.DS_Store
# 对外 README 的源文件（推仓库时复制成 README.md）
README.repo.md
